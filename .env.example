# Copy to .env and adjust. All values are optional.

# Whisper model: tiny | base | small | medium | large-v3
# For a 2 vCPU / 2-4 GB VPS, "base" is the sweet spot. Try "small" if you have 4 GB+ free.
WHISPER_MODEL=base

# CPU threads for transcription (0 = auto).
WHISPER_CPU_THREADS=0

# Largest upload accepted, in MB. Keep nginx's client_max_body_size a bit above this.
MAX_UPLOAD_MB=500

# How many videos are transcribed at the same time, and how many can wait in line.
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=10

# Long recordings are transcribed in pieces of this many seconds to keep memory
# use flat (~1 GB peak with the base model, whatever the video length).
CHUNK_SECONDS=600

# How long a finished transcript stays available (seconds).
RESULT_TTL_SECONDS=3600

# Local port nginx proxies to.
APP_PORT=8010

# Container memory cap.
MEM_LIMIT=2g
